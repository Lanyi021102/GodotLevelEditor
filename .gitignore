# Godot 4+ specific ignores
.godot/
/android/

# Local caches, generated builds, and operating-system files
.DS_Store
Thumbs.db
Desktop.ini
__pycache__/
/.validation/
/build/
/builds/
/exports/
/dist/
/.venv-wiki/
/site/
*.log
*.tmp
*.bak
*.translation

# Local credentials (Godot 4 stores export credentials inside .godot/)
.env
.env.*
!.env.example
/export_credentials.cfg

# Temporary files produced by editor tests
/tools/mechanisms/.canvas_test_*
/tools/mechanisms/.canvas_fixture_*
/tools/enemy_editor/.roundtrip.tres*
/tools/godot_level_editor_suite/native_drag_probe_*.tscn
/tools/level_editor/.reference_fixture_*.tscn
/tools/level_editor/quick_add_probe_*.tscn
