extends Node
const TASK := preload("res://addons/godot_level_editor_narrative/runtime/task_definition.gd")
const SPEC := preload("res://addons/godot_level_editor_narrative/runtime/task_nodes.gd")
const RUNNER := preload("res://addons/godot_level_editor_narrative/runtime/task_runner.gd")
var checks := 0
var failures := 0
var actions: Array = []
var temporary: Array[String] = []

func check(ok: bool, label: String) -> void:
	checks += 1
	if not ok: failures += 1
	print("[PASS] " if ok else "[FAIL] ", label)
func node(id: String, kind: String, parameters: Dictionary = {}) -> Dictionary:
	var p := SPEC.defaults(kind)
	p.merge(parameters, true)
	return {"id": id, "kind": kind, "params": p}
func edge(from: String, to: String, input := "run", output := "then") -> Dictionary:
	return {"id": "e_" + from + "_" + to + "_" + input, "from": from, "from_port": output, "to": to, "to_port": input}
func graph(nodes: Array, edges: Array) -> Resource:
	var result := TASK.new()
	result.graph_id = "test_task_nodes"
	result.nodes.assign(nodes)
	result.edges.assign(edges)
	return result
func perform(n: Dictionary, _context: Dictionary) -> Dictionary:
	actions.append(n.id)
	return {"ok": true, "reason": "test"}
func runner(g: Resource) -> RefCounted:
	var result := RUNNER.new()
	var errors: PackedStringArray = g.validate()
	check(errors.is_empty(), "graph validates: " + str(errors))
	check(result.configure(g, func(_id: String): return null, perform), "runner accepts task schema")
	return result
func ticks(count := 3) -> void:
	for i in count: await get_tree().physics_frame

func _ready() -> void:
	get_tree().create_timer(35, true).timeout.connect(func(): get_tree().quit(2))
	var r := runner(graph([node("start", "start"), node("wait", "delay", {"seconds": 0.5}), node("done", "show_dialog", {"dialog_id": "reception_intro"})], [edge("start", "wait"), edge("wait", "done")]))
	r.tick(0.1)
	check(actions.is_empty() and r.waits.has("wait"), "delay does not continue at start")
	r.tick(0.2)
	var save: Dictionary = r.capture()
	r.tick(0.31)
	check(actions == ["done"], "delay continues only after elapsed physics time")
	r.restore(save)
	r.tick(0.1)
	check(actions.size() == 1, "restoring a wait neither replays nor skips its remaining duration")
	r.tick(0.21)
	check(actions.size() == 2, "restored continuation executes once")
	actions.clear()
	r = runner(graph([node("a", "event_received", {"key": "a"}), node("b", "event_received", {"key": "b"}), node("join", "wait_all"), node("done", "show_dialog", {"dialog_id": "reception_intro"})], [edge("a", "join", "a"), edge("b", "join", "b"), edge("join", "done")]))
	r.queue_trigger("event_received", {"key": "a"}); r.tick()
	r.queue_trigger("event_received", {"key": "a"}); r.tick()
	check(actions.is_empty(), "Wait All deduplicates repeated inputs")
	var partial: Dictionary = r.capture()
	r.queue_trigger("event_received", {"key": "b"}); r.tick()
	check(actions == ["done"], "Wait All joins events that happen on separate frames")
	r.queue_trigger("event_received", {"key": "b"}); r.tick()
	check(actions.size() == 1, "completed join cannot repeatedly advance")
	r.restore(partial); r.queue_trigger("event_received", {"key": "b"}); r.tick()
	check(actions.size() == 2, "partially completed join survives restore")
	actions.clear()
	r = runner(graph([node("start", "start"), node("fork", "parallel"), node("fast", "delay", {"seconds": 0.1}), node("slow", "delay", {"seconds": 1.0}), node("join", "wait_any", {"cancel_others": true}), node("done", "show_dialog", {"dialog_id": "reception_intro"})], [edge("start", "fork"), edge("fork", "fast", "run", "a"), edge("fork", "slow", "run", "b"), edge("fast", "join", "a"), edge("slow", "join", "b"), edge("join", "done")]))
	r.tick(); check(r.waits.size() == 2, "Parallel activates multiple asynchronous branches")
	r.tick(0.2)
	check(actions == ["done"] and r.waits.is_empty(), "Wait Any advances once and cancels losing waits")
	r.tick(2.0); check(actions.size() == 1, "cancelled branch never produces a late completion")
	r = runner(graph([node("start", "start"), node("flag", "get_variable"), node("wait", "wait_until", {"timeout": 1.0}), node("done", "set_variable", {"key": "finished"})], [edge("start", "wait"), edge("flag", "wait", "condition", "value"), edge("wait", "done")]))
	r.tick(0.1); check(not r.variables.has("finished"), "Wait Until remains armed while condition is false")
	r.variables.flag = true; r.tick(0.1)
	check(r.variables.get("finished") == true, "Wait Until reacts to later world/variable changes")
	r = runner(graph([node("start", "start"), node("wait", "wait_event"), node("done", "set_variable", {"key": "finished"})], [edge("start", "wait"), edge("wait", "done")]))
	r.queue_trigger("event_received", {"key": "ready"}); r.tick()
	check(not r.variables.has("finished"), "Wait For Event consumes only events received after activation")
	r.queue_trigger("event_received", {"key": "ready"}); r.tick()
	check(r.variables.get("finished") == true, "armed event wait resumes on matching event")
	r = runner(graph([node("hit", "event_received", {"key": "hit"}), node("counter", "counter", {"target": 2}), node("done", "set_variable", {"key": "counted"})], [edge("hit", "counter"), edge("counter", "done", "run", "reached")]))
	r.queue_trigger("event_received", {"key": "hit"}); r.tick()
	check(r._value("counter", {}) == 1 and not r.variables.has("counted"), "counter exposes count without completing early")
	r.queue_trigger("event_received", {"key": "hit"}); r.tick()
	check(r.variables.get("counted") == true, "counter signals target reached")
	var invalid := graph([node("bad", "delay", {"seconds": -1.0})], [])
	check(not invalid.validate().is_empty(), "negative delay is rejected before runtime")
	invalid = graph([node("bad", "delay", {"seconds": "one"})], [])
	check(not invalid.validate().is_empty(), "mistyped task parameters are rejected")
	# Persisted child graph exercises real resource loading and asynchronous restoration.
	var child := graph([node("start", "start"), node("wait", "delay", {"seconds": 0.5}), node("end", "subgraph_end")], [edge("start", "wait"), edge("wait", "end")])
	var child_path := "res://tools/narrative/.task_nodes_child_%d.tres" % OS.get_process_id()
	temporary.append(child_path); ResourceSaver.save(child, child_path)
	r = runner(graph([node("start", "start"), node("child", "run_subgraph", {"graph_path": child_path}), node("done", "set_variable", {"key": "child_done"})], [edge("start", "child"), edge("child", "done")]))
	r.tick(); r.tick(0.1)
	var child_save: Dictionary = r.capture()
	r.tick(0.6)
	check(r.variables.get("child_done") == true, "subgraph completion resumes its parent")
	r.variables.clear(); r.restore(child_save); r.tick(0.1)
	check(not r.variables.has("child_done"), "restored subgraph retains its remaining wait")
	r.tick(0.6); check(r.variables.get("child_done") == true, "restored subgraph continues normally")
	var event_child := graph([node("received", "event_received", {"key": "child_signal"}), node("end", "subgraph_end")], [edge("received", "end")])
	ResourceSaver.save(event_child, child_path)
	# Use a new resource path to avoid ResourceLoader's cached earlier child definition.
	var event_child_path := child_path.replace(".tres", "_event.tres")
	temporary.append(event_child_path); ResourceSaver.save(event_child, event_child_path)
	r = runner(graph([node("start", "start"), node("child", "run_subgraph", {"graph_path": event_child_path}), node("done", "set_variable", {"key": "child_signal_done"})], [edge("start", "child"), edge("child", "done")]))
	r.tick(); r.tick()
	r.queue_trigger("event_received", {"key": "child_signal"}); r.tick()
	check(r.variables.get("child_signal_done") == true, "active subgraphs receive real external event triggers")
	await more_flows()
	await integration()
	for path in temporary:
		DirAccess.remove_absolute(path)
		if FileAccess.file_exists(path + ".uid"): DirAccess.remove_absolute(path + ".uid")
	print("TASK NODES: %d checks, %d failures" % [checks, failures])
	get_tree().quit(1 if failures else 0)

func more_flows() -> void:
	var r := runner(graph([node("start", "start"), node("timer", "timer", {"seconds": 1.0}), node("cancel", "event_received", {"key": "cancel"}), node("done", "set_variable", {"key": "expired"}), node("stopped", "set_variable", {"key": "stopped"})], [edge("start", "timer"), edge("timer", "done"), edge("cancel", "timer", "cancel"), edge("timer", "stopped", "run", "cancelled")]))
	r.tick(); r.tick(0.3)
	check(r._value("timer", {}) > 0.6 and r._value("timer", {}) < 0.8, "timer exposes remaining seconds")
	r.queue_trigger("event_received", {"key": "cancel"}); r.tick(0.1); r.tick(2.0)
	check(r.variables.get("stopped") == true and not r.variables.has("expired"), "timer cancellation emits only its cancellation path")
	r = runner(graph([node("start", "start"), node("false", "constant", {"value": false}), node("wait", "wait_until", {"timeout": 0.2}), node("timed_out", "set_variable", {"key": "timeout"})], [edge("start", "wait"), edge("false", "wait", "condition", "value"), edge("wait", "timed_out", "run", "timeout")]))
	r.tick(); r.tick(0.3)
	check(r.variables.get("timeout") == true and r.waits.is_empty(), "condition wait has an explicit timeout path")
	r = runner(graph([node("hit", "event_received", {"key": "hit"}), node("open", "event_received", {"key": "open"}), node("close", "event_received", {"key": "close"}), node("gate", "gate", {"opened": false}), node("count", "counter")], [edge("hit", "gate"), edge("open", "gate", "open"), edge("close", "gate", "close"), edge("gate", "count")]))
	r.queue_trigger("event_received", {"key": "hit"}); r.tick()
	check(r._value("count", {}) == 0, "closed gate blocks incoming execution")
	r.queue_trigger("event_received", {"key": "open"}); r.tick()
	r.queue_trigger("event_received", {"key": "hit"}); r.tick()
	check(r._value("count", {}) == 1, "open input enables the gate")
	r.queue_trigger("event_received", {"key": "close"}); r.tick()
	r.queue_trigger("event_received", {"key": "hit"}); r.tick()
	check(r._value("count", {}) == 1, "close input disables the gate again")
	var invalid := graph([node("item", "has_item", {"key": "key", "amount": 0})], [])
	check(not invalid.validate().is_empty(), "inventory checks reject nonpositive quantities")
	invalid = graph([node("wait", "wait_all")], [])
	check(not invalid.validate().is_empty(), "an unconnected join is rejected before runtime")
	var g := graph([node("number", "number", {"value": 4.0}), node("other", "number", {"value": 3.0}), node("compare", "compare", {"operator": ">="}), node("not", "not"), node("true", "constant", {"value": true}), node("any", "any")], [edge("number", "compare", "a", "value"), edge("other", "compare", "b", "value"), edge("compare", "not", "condition", "value"), edge("not", "any", "a", "value"), edge("true", "any", "b", "value")])
	r = runner(g)
	check(r._value("compare", {}) == true and r._value("not", {}) == false and r._value("any", {}) == true, "numeric comparison, NOT and OR compose with typed ports")

	var nested := graph([node("start", "start"), node("outer", "parallel"), node("inner", "parallel"), node("fast", "delay", {"seconds": 0.1}), node("medium", "delay", {"seconds": 0.3}), node("slow", "delay", {"seconds": 1.0}), node("inner_join", "wait_all"), node("outer_join", "wait_any", {"cancel_others": true}), node("done", "set_variable", {"key": "nested_done"})], [edge("start", "outer"), edge("outer", "inner", "run", "a"), edge("outer", "slow", "run", "b"), edge("inner", "fast", "run", "a"), edge("inner", "medium", "run", "b"), edge("fast", "inner_join", "a"), edge("medium", "inner_join", "b"), edge("inner_join", "outer_join", "a"), edge("slow", "outer_join", "b"), edge("outer_join", "done")])
	r = runner(nested)
	r.tick(); r.tick(0.2); r.tick(0.2)
	check(r.variables.get("nested_done") == true and r.waits.is_empty(), "nested parallel joins preserve parent scope and cancel the correct outer sibling")

func integration() -> void:
	var session: Node = load("res://tools/narrative/session_fixture.tscn").instantiate()
	add_child(session)
	await ticks(15)
	var director: Node = session.get_node("Narrative/Tasks")
	var catalog := preload("res://addons/godot_level_editor_suite/runtime/event_catalog.gd").new()
	var event := catalog.add_event()
	var task := catalog.add_task(event.event_id, "2")
	var authored := graph([node("start", "start"), node("goal", "objective_start", {"key": "get_key", "text": "取得物件并穿戴"}), node("save", "checkpoint_save"), node("wait", "delay", {"seconds": 100.0}), node("interact", "object_interacted", {"object": "$world/test_interaction"}), node("give", "change_item", {"key": "uniform"}), node("wear", "equip_item", {"key": "uniform"}), node("done", "objective_complete", {"key": "get_key"}), node("fail", "event_received", {"key": "fail"}), node("failure", "task_fail", {"task": task.task_id, "reason": "测试失败"})], [edge("start", "goal"), edge("goal", "save"), edge("save", "wait"), edge("interact", "give"), edge("give", "wear"), edge("wear", "done"), edge("fail", "failure")])
	authored.nodes.append_array([node("entered", "region_enter", {"object": "$world/test_region"}), node("exited", "region_exit", {"object": "$world/test_region"}), node("inside", "set_variable", {"key": "inside_seen"}), node("outside", "set_variable", {"key": "outside_seen"}), node("state", "state_changed", {"key": "ready"}), node("state_seen", "set_variable", {"key": "state_seen"}), node("restore_event", "event_received", {"key": "restore"}), node("restore_node", "checkpoint_restore"), node("save_progress_event", "event_received", {"key": "save_progress"}), node("save_progress", "checkpoint")])
	authored.edges.append_array([edge("entered", "inside"), edge("exited", "outside"), edge("state", "state_seen"), edge("restore_event", "restore_node"), edge("save_progress_event", "save_progress")])
	task.graph_path = "user://task_nodes_integration_%d.tres" % OS.get_process_id()
	temporary.append(task.graph_path)
	check(authored.validate().is_empty() and ResourceSaver.save(authored, task.graph_path) == OK, "integration graph saves as a native resource")
	var point: Node3D = load("res://scenes/mechanisms/interaction_point.tscn").instantiate()
	point.object_id = "test_interaction"
	session.world.add_child(point)
	point.global_position = session.player.global_position
	var region: Node3D = preload("res://addons/godot_level_editor/runtime/region.gd").new()
	region.object_id = "test_region"
	session.world.add_child(region)
	region.global_position = session.player.global_position + Vector3(20, 0, 0)
	var npc: Node3D = load("res://scenes/narrative/npc.tscn").instantiate()
	npc.object_id = "test_npc"
	var npc_agent: Node = preload("res://addons/godot_level_editor/runtime/actor_agent.gd").new()
	npc_agent.inventory = {"uniform": 2}
	npc.add_child(npc_agent)
	session.world.add_child(npc)
	director.active.clear(); director.event_states.clear(); director.task_states.clear()
	director.catalog = catalog
	director.bind_world(session.world)
	check(director.start_event(event.event_id), "new nodes run through the current event/level director")
	await ticks(3)
	check(not director.checkpoint.saved.is_empty(), "Save Checkpoint captures a live task with queued continuation")
	check(director.objective_label.text.contains("取得物件并穿戴"), "active subobjective appears in the HUD")
	var actor: Node = session.player
	var agent: Node = actor.get_node("LevelAgent")
	check(point.interact(actor), "generic interaction uses the existing player interaction contract")
	await ticks(3)
	check(agent.level_inventory_count("uniform") == 1, "object interaction changes the real actor inventory")
	check(agent.level_has_equipped("body", "uniform"), "equipment action changes the real actor slot")
	check(director.active[event.event_id].objectives.get_key.state == "completed", "interaction chain completes its subobjective")
	var helper := preload("res://addons/godot_level_editor_narrative/runtime/task_actions.gd").new()
	helper.world = session.world
	check(helper.condition(node("item", "has_item", {"key": "uniform", "amount": 1})), "inventory condition reads actual item quantities")
	check(not helper.condition(node("item", "has_item", {"key": "uniform", "amount": 2})), "inventory condition rejects an insufficient quantity")
	check(helper.condition(node("wear", "has_equipped", {"key": "uniform"})), "equipment condition checks the requested slot")
	check(not helper.condition(node("wear", "has_equipped", {"key": "uniform", "slot": "head"})), "equipment in a different slot does not satisfy the condition")
	check(helper.condition(node("item", "has_item", {"actor": "$world/test_npc", "key": "uniform", "amount": 2})), "generic inventory query can target an NPC independently of the player")
	check(helper.condition(node("wear", "has_equipped", {"key": "uniform", "slot": ""})), "empty equipment slot checks any equipped slot")
	agent.level_set_state("ready", true)
	region.player_entered.emit(actor)
	region.player_exited.emit(actor)
	await ticks(3)
	check(director.variables.get("state_seen") == true, "actor state changes reach the active task graph")
	check(director.variables.get("inside_seen") == true and director.variables.get("outside_seen") == true, "region enter and exit signals reach the active task graph")
	check(not agent.level_change_item("uniform", -2), "inventory cannot remove more items than owned")
	check(not agent.level_equip_item("head", "missing"), "unowned equipment cannot silently become equipped")
	var stored_position: Vector3 = actor.global_position
	actor.global_position += Vector3(1, 0, 0)
	director.variables["changed"] = true
	director.publish_event("fail"); await ticks(3)
	check(director.task_states[task.task_id] == "failed" and director.event_states[event.event_id] == "failed", "Fail Task stops the event without starting another task")
	check(director.retry_button.visible, "failed task exposes a usable checkpoint retry button")
	check(director.objective_label.text.contains("测试失败"), "task failure reason appears in the HUD")
	check(director.retry_from_checkpoint(), "failed task can restore its checkpoint")
	check(agent.level_inventory_count("uniform") == 0 and not agent.level_has_equipped("body", "uniform"), "checkpoint restores inventory and equipped slots")
	check(not director.variables.has("changed") and director.task_states[task.task_id] == "active", "checkpoint restores variables and the active task phase")
	check(director.active[event.event_id].objectives.get_key.state == "active", "checkpoint restores subobjective state")
	check(actor.global_position.distance_to(stored_position) < 0.2, "checkpoint restores the player's spatial state")
	await ticks(3)
	check(director.active[event.event_id].runner.waits.has("wait"), "checkpoint resumes after the save node instead of restarting the task")
	point.global_position = actor.global_position
	point.interact(actor); await ticks(3)
	check(agent.level_has_equipped("body", "uniform"), "restored interaction remains usable")
	director.publish_event("restore"); await ticks(3)
	check(agent.level_inventory_count("uniform") == 0 and director.active[event.event_id].objectives.get_key.state == "active", "Restore Checkpoint node safely resumes the saved graph")
	var saves: Array = []
	session.world.progress_requested.connect(func(data: Dictionary): saves.append(data))
	director.publish_event("save_progress"); await ticks(3)
	check(saves.size() == 1, "Save Progress retains the existing world/persistent-save request contract")
	var progress: Dictionary = director.capture_progress()
	check(director.restore_progress(progress), "extended task state supports progress round trip")
	session.queue_free(); await ticks(2)
